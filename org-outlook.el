(defun org-outlook-add-attachment (myfile)
  "Attach MYFILE to the current event, signaling on Graph failure."
  (let* ((id (org-outlook-get-appointment-property "OUTLOOK-ID"))
         (_valid (unless id (user-error "No active Outlook event on this entry")))
         (filename (file-name-nondirectory myfile))
         (filebytes (with-temp-buffer
                      (set-buffer-multibyte nil)
                      (insert-file-contents-literally myfile)
                      (base64-encode-string (buffer-string) t))))
    (prog1
        (org-outlook--graph-data
         'post (concat org-outlook-events-create-url "/" (url-hexify-string id) "/attachments")
         :body `(("@odata.type" . "#microsoft.graph.fileAttachment")
                 ("name" . ,filename)
                 ("contentBytes" . ,filebytes)))
      (message "Added attachment"))))

(add-hook 'org-capture-prepare-finalize-hook #'org-outlook-finalize-capture)
(setq org-outlook-events-delta-url "https://graph.microsoft.com/v1.0/me/calendarview/delta")

(defun org-outlook--managed-id-p (id remote)
  "Return non-nil when this entry records ownership of ID and REMOTE.
Created meetings record their local Org ID explicitly, since it may be
an existing UUID.  Older captures can be recognized by their transaction
and marked generated child.  Imported and legacy entries support hashed IDs."
  (and id remote
       (or (equal id (org-entry-get nil "OUTLOOK-LOCAL-ID"))
           (equal id (secure-hash 'sha256 remote))
           (let ((legacy (org-entry-get nil "OUTLOOK-LEGACY-ID")))
             (and legacy (equal id (secure-hash 'sha256 legacy))))
           (and (equal "1" (org-entry-get nil "OUTLOOK-SYNC-VERSION"))
                (org-entry-get nil "OUTLOOK-TRANSACTION-ID")
                (org-outlook--managed-child remote)))))

(defun org-outlook-delete-by-id (id)
  "Retire the managed event ID while retaining its personal Org content.
Unknown or already retired IDs are harmless."
  (let ((location (org-id-find id)))
    (when location
      (with-current-buffer (find-file-noselect (car location))
        (save-restriction
          (widen)
          (save-excursion
            (goto-char (cdr location))
            (let ((remote (org-entry-get nil "OUTLOOK-ID")))
              (when (and (equal id (org-entry-get nil "ID"))
                         (org-outlook--managed-id-p id remote))
                (let ((edits (org-outlook--entry-edits
                              (current-buffer) (list :id remote :begin (point)) nil)))
                  (atomic-change-group
                    (dolist (edit (sort edits (lambda (a b) (> (nth 1 a) (nth 1 b)))))
                      (goto-char (nth 1 edit))
                      (delete-region (nth 1 edit) (nth 2 edit))
                      (insert (nth 3 edit)))
                    (save-buffer)))))))))))

(defun org-outlook--build-query-string (params)
  "URL-encode PARAMS alist into a query string.
Only values are percent-encoded; parameter names are kept literal."
  (mapconcat
   (lambda (pair)
     (concat (car pair) "=" (url-hexify-string (cdr pair))))
   params "&"))

(defun org-outlook-retrieve-events-delta (&optional nextlink start end)
  "Retrieve a delta page, following NEXTLINK verbatim when supplied.
START and END fix the dates of an initial round even across midnight."
  (org-outlook--graph-data
   'get (or nextlink
            (concat org-outlook-events-delta-url "?"
                    (org-outlook--build-query-string
                     `(("startDateTime" . ,(org-outlook--utc-string (org-outlook--window-boundary (or start (org-outlook-start)))))
                       ("endDateTime" . ,(org-outlook--utc-string (org-outlook--window-boundary (or end (org-outlook-end)) t)))))))
   :headers '(("Prefer" . "outlook.timezone=\"UTC\""))))

(defun org-outlook-last-delta ()
  (let*
      ((org-outlook-token-cache (plstore-open (expand-file-name org-outlook-token-cache-file)))
       (token (plist-get (cdr (plstore-get org-outlook-token-cache "delta")) :delta)))
    (plstore-close org-outlook-token-cache)
    token))


(defun org-outlook--graph-page-events (data)
  "Return events from a valid Graph collection DATA.
An empty value array is a valid page; a missing value is a protocol error."
  (unless (and (listp data) (assq 'value data)
               (vectorp (alist-get 'value data)))
    (signal 'org-outlook-graph-error '("Invalid Graph collection response")))
  (append (alist-get 'value data) nil))

(cl-defstruct org-outlook-sync-batch
  "A fetched round of changes whose DELTA must not be saved before application."
  events delta start end)

(defun org-outlook-retrieve-delta-pages (&optional nextlink initial)
  "Fetch a complete delta round without changing the saved cursor.
Return an `org-outlook-sync-batch'.  INITIAL starts a new calendar view;
otherwise NEXTLINK or the saved cursor continues the existing view."
  (let* ((start (org-outlook-start))
         (end (org-outlook-end))
         (url (unless initial (or nextlink (org-outlook-last-delta))))
         seen chunks delta done)
    (while (not done)
      (when (member url seen)
        (signal 'org-outlook-graph-error '("Repeated Graph continuation URL")))
      (push url seen)
      (let ((data (org-outlook-retrieve-events-delta url start end)))
        (push (org-outlook--graph-page-events data) chunks)
        (setq delta (alist-get '@odata.deltaLink data)
              url (alist-get '@odata.nextLink data))
        (cond ((and (stringp delta) (not (string-empty-p delta))
                    (org-outlook--graph-url-p delta) (not url))
               (setq done t))
              ((or (not (stringp url)) (string-empty-p url) delta)
               (signal 'org-outlook-graph-error '("Invalid Graph delta continuation"))))))
    (make-org-outlook-sync-batch :events (apply #'append (nreverse chunks))
                                :delta delta :start start :end end)))

(defun org-outlook-retrieve-events (&optional nextlink)
  "Retrieve a calendar page, following NEXTLINK verbatim when supplied."
  (org-outlook--graph-data
   'get (or nextlink
            (concat org-outlook-events-url "?"
                    (org-outlook--build-query-string
                     `(("startDateTime" . ,(org-outlook--utc-string (org-outlook--window-boundary (org-outlook-start))))
                       ("endDateTime" . ,(org-outlook--utc-string (org-outlook--window-boundary (org-outlook-end) t)))))))
   :headers '(("Prefer" . "outlook.timezone=\"UTC\""))))

(defun org-outlook-retrieve-pages (&optional nextlink)
  "Return every calendar event, requesting complete continuation URLs."
  (let ((url nextlink) seen chunks done)
    (while (not done)
      (when (member url seen)
        (signal 'org-outlook-graph-error '("Repeated Graph continuation URL")))
      (push url seen)
      (let ((data (org-outlook-retrieve-events url)))
        (push (org-outlook--graph-page-events data) chunks)
        (setq url (alist-get '@odata.nextLink data)
              done (null url))
        (when (and url (not (stringp url)))
          (signal 'org-outlook-graph-error '("Invalid Graph continuation URL")))))
    (apply #'append (nreverse chunks))))

(defvar org-outlook-full-sync-interval-days 7
  "Number of days between full syncs for validation.
Set to nil to disable periodic full syncs.  A changed date window always
requires a new full sync because Graph cursors encode a fixed date range.")

(defvar org-outlook--sync-running nil
  "Non-nil while a sync is fetching, applying, or committing changes.")

(defun org-outlook--sync-state ()
  "Read the committed cursor and its calendar window."
  (let ((cache (plstore-open (expand-file-name org-outlook-token-cache-file))))
    (unwind-protect
        (cdr (plstore-get cache "delta"))
      (plstore-close cache))))

(defun org-outlook-last-full-sync-time ()
  "Return the time of the last committed full synchronization."
  (let ((time-str (plist-get (org-outlook--sync-state) :full-sync)))
    (when time-str (parse-iso8601-time-string time-str))))

(defun org-outlook--commit-sync (batch full)
  "Commit BATCH after local saves and ID indexing succeed.
FULL also records full-sync completion in the same cache write."
  (let* ((previous (org-outlook--sync-state))
         (full-time (if full (format-time-string "%Y-%m-%dT%H:%M:%S%z")
                      (plist-get previous :full-sync))))
    (org-outlook-set-token-field
     "delta" (list :delta (org-outlook-sync-batch-delta batch)
                   :start (org-outlook-sync-batch-start batch)
                   :end (org-outlook-sync-batch-end batch)
                   :timezone org-outlook-local-timezone
                   :id-type "immutable"
                   :tenant org-outlook-tenant-id :client org-outlook-client-id
                   :full-sync full-time)
     nil)))

(defun org-outlook--sync-files ()
  "Return the destination and registered Org ID files, including refilings."
  (delete-dups
   (mapcar #'expand-file-name
           (append (list org-outlook-file) org-id-files
                   (when (hash-table-p org-id-locations)
                     (let (files)
                       (maphash (lambda (_id file) (push file files)) org-id-locations)
                       files))))))

(defun org-outlook--entry-in-window-p (start end)
  "Test this entry's server instants, or its legacy timestamp, against the window."
  (save-excursion
    (let* ((from (org-entry-get nil "OUTLOOK-START"))
           (to (org-entry-get nil "OUTLOOK-END"))
           (times (if (and from to)
                      (cons (org-outlook--parse-time from org-outlook-local-timezone)
                            (org-outlook--parse-time to org-outlook-local-timezone))
                    (let ((limit (save-excursion (outline-next-heading) (point))))
                      (forward-line 1)
                      (when (re-search-forward org-ts-regexp limit t)
                        (let* ((parts (cadr (org-timestamp-from-string (match-string-no-properties 0))))
                               (make (lambda (suffix)
                                       (encode-time
                                        0 (or (plist-get parts (intern (concat ":minute-" suffix))) 0)
                                        (or (plist-get parts (intern (concat ":hour-" suffix))) 0)
                                        (plist-get parts (intern (concat ":day-" suffix)))
                                        (plist-get parts (intern (concat ":month-" suffix)))
                                        (plist-get parts (intern (concat ":year-" suffix)))
                                        (org-outlook--timezone org-outlook-local-timezone)))))
                          (cons (funcall make "start") (funcall make "end"))))))))
      (and times
           (time-less-p (car times) (org-outlook--window-boundary end t))
           (time-less-p (org-outlook--window-boundary start) (cdr times))))))

(defun org-outlook--managed-child (id)
  "Return the bounds of the direct generated child for remote ID.
Personal children are never selected by their title alone."
  (save-excursion
    (let ((level (org-outline-level))
          (end (save-excursion (org-end-of-subtree t t) (point)))
          found)
      (outline-next-heading)
      (while (< (point) end)
        (when (and (= (org-outline-level) (1+ level))
                   (equal id (org-entry-get nil "OUTLOOK-MANAGED-ID")))
          (when found (error "Duplicate generated Outlook sections"))
          (setq found (cons (point) (save-excursion (org-end-of-subtree t t) (point)))))
        (outline-next-heading))
      found)))

(defun org-outlook--entry-edits (buffer entry event)
  "Plan safe edits to ENTRY in BUFFER from EVENT, or retire it when nil.
Only the parent's reserved properties and marked generated child change.
Legacy body text is retained in a commented child on first migration."
  (with-current-buffer buffer
    (save-restriction
      (widen)
      (save-excursion
        (goto-char (plist-get entry :begin))
        (let* ((begin (point))
               (id (plist-get entry :id))
               (level (org-outline-level))
               (section-end (save-excursion (outline-next-heading) (point)))
               (child (org-outlook--managed-child id))
               (prefix (buffer-substring-no-properties begin section-end))
               (generated (and event (org-outlook--event-section event (1+ level))))
               (parent
                (with-temp-buffer
                  (org-mode)
                  (insert prefix)
                  (goto-char (point-min))
                  (unless (org-entry-get nil "OUTLOOK-SYNC-VERSION")
                    (org-end-of-meta-data)
                    (let ((legacy (buffer-substring-no-properties (point) (point-max))))
                      (delete-region (point) (point-max))
                      (unless (string-empty-p (string-trim legacy))
                        (goto-char (point-max))
                        (insert "\n" (make-string (1+ level) ?*)
                                " COMMENT Preserved legacy text\n"
                                "Retained during migration; move personal notes outside this child.\n\n"
                                legacy)
                        (unless (bolp) (insert "\n")))))
                  (goto-char (point-min))
                  (org-entry-put nil "OUTLOOK-SYNC-VERSION" "1")
                  (let ((local-id (org-entry-get nil "ID")))
                    (when local-id (org-entry-put nil "OUTLOOK-LOCAL-ID" local-id)))
                  (if event
                      (let ((local-id (org-entry-get nil "ID"))
                            (legacy (or (org-entry-get nil "OUTLOOK-LEGACY-ID") id)))
                        (org-outlook--put-properties (org-outlook--event-properties event))
                        (when local-id
                          (org-entry-put nil "ID" local-id)
                          (unless (equal local-id (secure-hash 'sha256 (alist-get 'id event)))
                            (org-entry-put nil "OUTLOOK-LEGACY-ID" legacy)))
                        (org-entry-delete nil "OUTLOOK-RETIRED-ID")
                        (org-entry-delete nil "OUTLOOK-DELETED"))
                    (org-entry-put nil "OUTLOOK-RETIRED-ID" id)
                    (org-entry-put nil "OUTLOOK-DELETED" "t")
                    (org-entry-put nil "OUTLOOK-STATUS" "DELETED")
                    (org-entry-delete nil "OUTLOOK-ID")
                    (org-entry-delete nil "TEAMSURL"))
                  (goto-char (point-max))
                  (unless (bolp) (insert "\n"))
                  (when (and generated (not child)) (insert generated))
                  (buffer-string))))
          (append (list (list buffer begin section-end parent))
                  (when child (list (list buffer (car child) (cdr child) (or generated ""))))))))))

(defun org-outlook--managed-entries (buffer start end)
  "Index verifiably imported headlines in BUFFER for dates START and END."
  (with-current-buffer buffer
    (save-restriction
      (widen)
      (save-excursion
        (goto-char (point-min))
        (let (entries)
          (org-map-entries
           (lambda ()
             (let ((remote (or (org-entry-get nil "OUTLOOK-ID")
                               (org-entry-get nil "OUTLOOK-RETIRED-ID")))
                   (id (org-entry-get nil "ID")))
               (when (org-outlook--managed-id-p id remote)
                 (push (list :id remote :begin (point)
                             :end (save-excursion (org-end-of-subtree t t) (point))
                             :change (org-entry-get nil "CHANGEKEY")
                             :timezone (org-entry-get nil "OUTLOOK-TIMEZONE")
                             :id-type (org-entry-get nil "OUTLOOK-ID-TYPE")
                             :version (org-entry-get nil "OUTLOOK-SYNC-VERSION")
                             :child (org-outlook--managed-child remote)
                             :deleted (org-entry-get nil "OUTLOOK-DELETED")
                             :in-window (if (and (org-entry-get nil "OUTLOOK-START")
                                                 (org-entry-get nil "OUTLOOK-END"))
                                            (org-outlook--entry-in-window-p start end)
                                          (save-excursion
                                          (let ((child (org-outlook--managed-child remote)))
                                            (when child (goto-char (car child)))
                                            (org-outlook--entry-in-window-p start end)))))
                       entries))))
           nil nil)
          entries)))))

(defun org-outlook--legacy-id-map (start end)
  "Translate existing mutable IDs before associating a new immutable snapshot.
Do not change files if translation is denied or incomplete.  Keep old Org
IDs so existing links survive.  Translation requires delegated User.Read."
  (let (ids (mapping (make-hash-table :test #'equal)))
    (dolist (file (org-outlook--sync-files))
      (when (file-exists-p file)
        (let ((buffer (find-file-noselect file)))
          (dolist (entry (org-outlook--managed-entries buffer start end))
            (unless (equal "immutable" (plist-get entry :id-type))
              (push (plist-get entry :id) ids))))))
    (setq ids (delete-dups ids))
    (while ids
      (let* ((batch (seq-take ids 1000))
             (data (org-outlook--graph-data
                    'post "https://graph.microsoft.com/v1.0/me/translateExchangeIds"
                    :body `(("inputIds" . ,(vconcat batch))
                            ("sourceIdType" . "restId") ("targetIdType" . "restImmutableEntryId")))))
        (dolist (item (org-outlook--graph-page-events data))
          (let ((source (alist-get 'sourceId item)) (target (alist-get 'targetId item)))
            (when (and (member source batch) (stringp target) (not (string-empty-p target)))
              (puthash source target mapping))))
        (unless (seq-every-p (lambda (id) (gethash id mapping)) batch)
          (signal 'org-outlook-graph-error '("Incomplete event ID migration; local notes were not changed")))
        (setq ids (nthcdr (length batch) ids))))
    mapping))

(defun org-outlook--apply-sync-batch (batch full)
  "Apply BATCH and reconcile missing IDs when FULL is non-nil.
Render and plan every edit before changing buffers.  Reject unsaved local
edits in affected buffers.  Roll back buffer edits on application failures.
Save all affected files and the ID index before returning to the caller.
The caller commits the cursor last; an interrupted disk save can therefore
be retried safely from the previous cursor."
  (let ((events (make-hash-table :test #'equal))
        (locals (make-hash-table :test #'equal))
        (start (org-outlook-sync-batch-start batch))
        (end (org-outlook-sync-batch-end batch))
        edits buffers groups saved accepted migrations)
    ;; Delta rounds can mention an ID more than once; the final version wins.
    (dolist (event (org-outlook-sync-batch-events batch))
      (let ((id (alist-get 'id event)))
        (unless (and (stringp id) (not (string-empty-p id)))
          (signal 'org-outlook-graph-error '("Event has no valid Graph ID")))
        (puthash id event events)))
    (setq migrations (org-outlook--legacy-id-map start end))
    (dolist (file (org-outlook--sync-files))
      (when (or (equal file (expand-file-name org-outlook-file)) (file-exists-p file))
        (let ((buffer (find-file-noselect file)))
          (with-current-buffer buffer
            (unless (derived-mode-p 'org-mode) (org-mode)))
          (dolist (entry (org-outlook--managed-entries buffer start end))
            (let* ((id (plist-get entry :id))
                   (canonical (or (gethash id migrations) id))
                   (event (gethash canonical events))
                   (remove (and (not (plist-get entry :deleted))
                                (plist-get entry :in-window)
                                (or (alist-get '@removed event)
                                    (and full (not event))))))
              (when (gethash canonical locals)
                (error "Duplicate managed Outlook ID in local files: %s" id))
              (puthash canonical (cons buffer entry) locals)
              (cond
               (remove
                (setq edits (append (org-outlook--entry-edits buffer entry nil) edits)))
               ((and event (not (alist-get '@removed event))
                     (or (not (plist-get entry :version))
                         (gethash id migrations)
                         (not (plist-get entry :child))
                         (not (equal org-outlook-local-timezone (plist-get entry :timezone)))
                         (plist-get entry :deleted)
                         (not (equal (alist-get 'changeKey event) (plist-get entry :change)))))
                (setq edits (append (org-outlook--entry-edits buffer entry event) edits)))))))))
    (maphash
     (lambda (id event)
       (unless (or (gethash id locals) (alist-get '@removed event))
         (let ((buffer (find-file-noselect (expand-file-name org-outlook-file))))
           (push (list buffer (with-current-buffer buffer
                                (save-restriction (widen) (point-max)))
                       (with-current-buffer buffer
                         (save-restriction (widen) (point-max)))
                       (concat "\n" (org-outlook-build-element event) "\n"))
                 edits))))
     events)
    (setq buffers (delete-dups (mapcar #'car edits)))
    ;; An unchanged nested event must not disappear with its edited parent.
    (maphash
     (lambda (_id local)
       (dolist (edit edits)
         (when (and (eq (car local) (car edit))
                    (< (nth 1 edit) (plist-get (cdr local) :begin))
                    (< (plist-get (cdr local) :begin) (nth 2 edit)))
           (error "Overlapping managed Outlook entries in %s" (buffer-name (car local))))))
     locals)
    ;; Catch overlapping parent/child edits before modifying any buffer.
    (dolist (buffer buffers)
      (with-current-buffer buffer
        (when (or buffer-read-only (buffer-modified-p)
                  (not (verify-visited-file-modtime buffer)))
          (error "Save or reload local changes before syncing %s" (buffer-name))))
      (let ((limit 0))
        (dolist (edit (sort (cl-remove-if-not (lambda (edit) (eq buffer (car edit)))
                                            (copy-sequence edits))
                           (lambda (a b) (< (nth 1 a) (nth 1 b)))))
          (when (< (nth 1 edit) limit)
            (error "Overlapping managed Outlook entries in %s" (buffer-name buffer)))
          (setq limit (nth 2 edit)))))
    (unwind-protect
        (progn
          (dolist (buffer buffers)
            (with-current-buffer buffer
              (let ((group (prepare-change-group)))
                (push (cons buffer group) groups)
                (activate-change-group group))))
          (dolist (buffer buffers)
            (with-current-buffer buffer
              (save-restriction
                (widen)
                (save-excursion
                  (dolist (edit (sort (cl-remove-if-not (lambda (edit) (eq buffer (car edit)))
                                                      (copy-sequence edits))
                                     (lambda (a b) (> (nth 1 a) (nth 1 b)))))
                    (goto-char (nth 1 edit))
                    (delete-region (nth 1 edit) (nth 2 edit))
                    (insert (nth 3 edit)))))))
          (dolist (buffer buffers)
            (with-current-buffer buffer (save-buffer))
            (push buffer saved))
          (org-id-update-id-locations (org-outlook--sync-files))
          (org-id-locations-save)
          (dolist (entry groups)
            (with-current-buffer (car entry) (accept-change-group (cdr entry))))
          (setq accepted t))
      (unless accepted
        (dolist (entry groups)
          (with-current-buffer (car entry)
            (cancel-change-group (cdr entry))
            (set-buffer-modified-p nil)))
        ;; Restore files already saved if a later save or index update failed.
        (dolist (buffer saved)
          (with-current-buffer buffer
            (set-buffer-modified-p t)
            (save-buffer)))))))

(defun org-outlook-init-delta-link ()
  "Initialize delta tracking through a reconciled full synchronization.
Never establish a baseline without applying its events."
  (interactive)
  (org-outlook-full-sync))

(defun org-outlook-full-sync ()
  "Reconcile the current date window using a complete initial delta round."
  (interactive)
  (when org-outlook--sync-running (user-error "Outlook sync is already running"))
  (unless (hash-table-p org-id-locations) (org-id-locations-load))
  (let* ((org-outlook--sync-running t)
         (batch (org-outlook-retrieve-delta-pages nil t)))
    (org-outlook--apply-sync-batch batch t)
    (org-outlook--commit-sync batch t)
    (message "Full Outlook sync complete")))

(defun org-outlook-delta-sync-impl ()
  "Apply a fetched delta round and commit its cursor only after local saves."
  (when org-outlook--sync-running (user-error "Outlook sync is already running"))
  (unless (hash-table-p org-id-locations) (org-id-locations-load))
  (let* ((org-outlook--sync-running t)
         (batch (org-outlook-retrieve-delta-pages)))
    (org-outlook--apply-sync-batch batch nil)
    (org-outlook--commit-sync batch nil)
    (message "Delta Outlook sync complete")))

(defun org-outlook-sync (&optional force-full)
  "Synchronize Outlook, using a full view when FORCE-FULL is non-nil.
Rebuild the view when its date range changes or its cursor expires.
Other fetch or local errors propagate without advancing the saved cursor."
  (interactive "P")
  (when org-outlook--sync-running (user-error "Outlook sync is already running"))
  (org-id-locations-load)
  (let* ((state (org-outlook--sync-state))
         (last-full (org-outlook-last-full-sync-time))
         (full (or force-full (not (plist-get state :delta))
                   (not (equal (plist-get state :tenant) org-outlook-tenant-id))
                   (not (equal (plist-get state :client) org-outlook-client-id))
                   (not (equal (plist-get state :timezone) org-outlook-local-timezone))
                   (not (equal (plist-get state :id-type) "immutable"))
                   (not (equal (plist-get state :start) (org-outlook-start)))
                   (not (equal (plist-get state :end) (org-outlook-end)))
                   (and org-outlook-full-sync-interval-days last-full
                        (time-less-p
                         (time-add last-full (days-to-time org-outlook-full-sync-interval-days))
                         (current-time))))))
    (if full
        (org-outlook-full-sync)
      (condition-case err
          (org-outlook-delta-sync-impl)
        (org-outlook-graph-error
         (let ((result (nth 2 err)))
           (if (and (org-outlook-graph-result-p result)
                    (eq (org-outlook-graph-result-error result) 'gone))
               (org-outlook-full-sync)
             (signal (car err) (cdr err)))))))))


(defun org-outlook-check-availability (schedules start-time end-time &optional availability-interval)
  "Check SCHEDULES between START-TIME and END-TIME.
AVAILABILITY-INTERVAL defaults to 30 minutes.  Signal on Graph failure."
  (interactive
   (list (split-string (read-string "Email addresses (space separated): "))
         (read-string "Start time (YYYY-MM-DDTHH:MM:SS): ")
         (read-string "End time (YYYY-MM-DDTHH:MM:SS): ")))
  (let ((start (org-outlook--parse-time start-time org-outlook-local-timezone t))
        (end (org-outlook--parse-time end-time org-outlook-local-timezone t)))
    (unless (time-less-p start end) (user-error "Availability end must be after its start"))
    (org-outlook--graph-data
   'post org-outlook-schedule-url
   :body `(("schedules" . ,(vconcat schedules))
           ("startTime" . (("dateTime" . ,(org-outlook--utc-string start)) ("timeZone" . "UTC")))
           ("endTime" . (("dateTime" . ,(org-outlook--utc-string end)) ("timeZone" . "UTC")))
           ("availabilityViewInterval" . ,(or availability-interval 30)))
   :headers '(("Prefer" . "outlook.timezone=\"UTC\"")))))

(defun org-outlook-display-availability (data)
  "Display availability data in a readable format."
  (let ((schedules (append (assoc-default 'value data) nil))
        (buffer-name "*Outlook Availability*"))
    (with-current-buffer (get-buffer-create buffer-name)
      (erase-buffer)
      (insert "=== Outlook Availability Report ===\n\n")
      (dolist (schedule schedules)
        (let ((schedule-id (assoc-default 'scheduleId schedule))
              (availability-view (assoc-default 'availabilityView schedule))
              (schedule-items (append (assoc-default 'scheduleItems schedule) nil))
              (working-hours (assoc-default 'workingHours schedule)))

          (insert (format "📧 %s\n" schedule-id))
          (insert (format "Availability View: %s\n" availability-view))
          (insert "   (0=free, 1=tentative, 2=busy, 3=oof, 4=workingElsewhere)\n\n")

          (if schedule-items
              (progn
                (insert "Schedule Items:\n")
                (dolist (item schedule-items)
                  (let ((status (assoc-default 'status item))
                        (subject (assoc-default 'subject item))
                        (start (assoc-default 'start item))
                        (end (assoc-default 'end item))
                        (location (assoc-default 'location item))
                        (is-private (eq t (assoc-default 'isPrivate item))))
                    (insert (format "  • %s: %s\n"
                                  (upcase status)
                                  (if (and subject (not is-private)) subject "Private/No Subject")))
                    (insert (format "    Time: %s - %s\n"
                                  (org-outlook-format-datetime start)
                                  (org-outlook-format-datetime end)))
                    (when (and location (not is-private))
                      (insert (format "    Location: %s\n" location)))
                    (insert "\n"))))
            (insert "No scheduled items\n\n"))

          (when working-hours
            (let ((days (append (assoc-default 'daysOfWeek working-hours) nil))
                  (start-time (assoc-default 'startTime working-hours))
                  (end-time (assoc-default 'endTime working-hours)))
              (insert (format "Working Hours: %s %s - %s\n"
                            (mapconcat 'capitalize days ", ")
                            (substring start-time 0 5)
                            (substring end-time 0 5)))))

          (insert "\n" (make-string 50 ?-) "\n\n")))

      (goto-char (point-min))
      (display-buffer (current-buffer)))))

(defun org-outlook-format-datetime (datetime)
  "Display Graph DATETIME (string or dateTimeTimeZone) in the configured zone."
  (format-time-string "%Y-%m-%d %H:%M"
                      (if (stringp datetime) (org-outlook--parse-time datetime "UTC")
                        (org-outlook--event-time datetime))
                      (org-outlook--timezone org-outlook-local-timezone)))

(defun org-outlook--availability-schedules (emails start-time end-time)
  "Fetch and validate EMAILS schedules between START-TIME and END-TIME.
Unknown, missing, or failed schedules signal instead of implying availability.
Return the validated schedules so callers can inspect conflicts without
fetching a second, potentially different response."
  (let* ((emails (if (listp emails) emails (list emails)))
         (data (org-outlook-check-availability emails start-time end-time))
         (schedules (append (alist-get 'value data) nil)))
    (unless (and emails (= (length emails) (length schedules))
                 (seq-every-p
                  (lambda (email)
                    (= 1 (cl-count email schedules :key (lambda (s) (alist-get 'scheduleId s))
                                   :test (lambda (a b) (equal (downcase a) (downcase (or b "")))))))
                  emails)
                 (seq-every-p (lambda (s) (and (not (alist-get 'error s))
                                               (assq 'scheduleItems s)
                                               (vectorp (alist-get 'scheduleItems s))))
                              schedules))
      (signal 'org-outlook-graph-error '("Availability is unknown for one or more attendees")))
    schedules))

(defun org-outlook-persons-available-p (emails start-time end-time)
  "Return t only when every requested EMAILS schedule is known and free.
Unknown, missing, or failed schedules signal instead of implying availability."
  (not (org-outlook-get-busy-attendees
        (org-outlook--availability-schedules emails start-time end-time)
        start-time end-time)))

(defun org-outlook-i-am-available-p (start-time end-time)
  "Check if you are available between START-TIME and END-TIME.
Uses org-outlook-user-email variable. Returns t if available, nil if busy.
START-TIME and END-TIME should be in format \"2019-03-15T09:00:00\"."
  (if org-outlook-user-email
      (org-outlook-persons-available-p org-outlook-user-email start-time end-time)
    (user-error "Please set org-outlook-user-email first")))


(provide 'org-outlook)

