(define-error 'org-outlook-graph-error "Microsoft Graph request failed")

(cl-defstruct org-outlook-graph-result
  "Graph response.  ERROR is nil on success, otherwise a failure symbol.
STATUS is the HTTP status, DATA the decoded JSON, HEADERS the response
headers, and RETRY-AFTER the server's retry instruction when present."
  status data headers error retry-after)

(defun org-outlook--graph-url-p (url)
  "Return non-nil if URL is an HTTPS Microsoft Graph URL."
  (let ((parsed (url-generic-parse-url url)))
    (and (equal (url-type parsed) "https")
         (equal (url-host parsed) "graph.microsoft.com")
         (not (url-user parsed))
         (not (url-password parsed))
         (= (url-port parsed) 443))))

(defun org-outlook--graph-response (response &optional network-error)
  "Convert plz RESPONSE into a typed result, handling NETWORK-ERROR."
  (let* ((status (and response (plz-response-status response)))
         (headers (and response (plz-response-headers response)))
         (body (and response (plz-response-body response)))
         (failure (cond ((not status) 'network)
                        ((= status 401) 'unauthorized)
                        ((= status 403) 'forbidden)
                        ((= status 404) 'not-found)
                        ((= status 410) 'gone)
                        ((= status 429) 'throttled)
                        ((>= status 500) 'server)
                        ((not (<= 200 status 299)) 'http)))
         data)
    (condition-case nil
        (unless (or (null body) (string-match-p "\\`[[:space:]]*\\'" body))
          (let ((json-object-type 'alist) (json-array-type 'vector)
                (json-key-type 'symbol) (json-false :json-false)
                (json-null nil))
            (setq data (json-read-from-string body))))
      (error (unless failure (setq failure 'invalid-response))))
    (make-org-outlook-graph-result
     :status status :data data :headers headers
     :error (or failure (and network-error 'network))
     :retry-after (cdr (assoc-string "retry-after" headers t)))))

(defun org-outlook--graph-headers (headers)
  "Escape HEADERS for the quoted curl configuration generated by plz."
  (mapcar
   (lambda (header)
     (cons (car header)
           (replace-regexp-in-string
            "[\\\\\"]" (lambda (match) (concat "\\" match))
            (cdr header) t t)))
   headers))

(cl-defun org-outlook-graph-request (method url &key body headers)
  "Synchronously request METHOD at Graph URL and return a typed result.
BODY is a JSON value.  HEADERS contains additional request headers.
Refresh credentials and retry once on HTTP 401 only.  Other failures,
including throttling and server errors, are returned without replaying
potentially non-idempotent writes.  No tokens or response bodies are logged."
  (unless (org-outlook--graph-url-p url)
    (error "Refusing to send Graph credentials to an untrusted URL"))
  (let ((payload (and body (json-encode body))) result (attempt 0))
    (while (< attempt 2)
      (setq attempt (1+ attempt))
      (setq result
            (condition-case err
                (org-outlook--graph-response
                 (plz method url
                   :headers (append
                             `(("Authorization" . ,(concat "Bearer " (org-outlook-bearer-token)))
                               ("Content-Type" . "application/json"))
                             (org-outlook--graph-headers headers))
                   :body payload :as 'response :timeout 60))
              (plz-error
               (let* ((detail (cadr err))
                      (response (and (plz-error-p detail)
                                     (plz-error-response detail))))
                 (org-outlook--graph-response response t)))))
      (if (and (= attempt 1)
               (eq (org-outlook-graph-result-error result) 'unauthorized))
          (org-outlook-force-token-refresh)
        (setq attempt 2)))
    result))

(cl-defun org-outlook--graph-data (method url &key body headers)
  "Return successful Graph JSON or signal `org-outlook-graph-error'.
The condition contains a safe message and the typed result."
  (let* ((result (org-outlook-graph-request method url :body body :headers headers))
         (failure (org-outlook-graph-result-error result)))
    (when failure
      (signal 'org-outlook-graph-error
              (list (format "Graph %s failed: %s (HTTP %s)%s"
                            method failure (or (org-outlook-graph-result-status result) "none")
                            (if (org-outlook-graph-result-retry-after result)
                                (format "; Retry-After: %s" (org-outlook-graph-result-retry-after result))
                              ""))
                    result)))
    (org-outlook-graph-result-data result)))

